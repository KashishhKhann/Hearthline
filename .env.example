# Copy this file to .env and fill in your values.
# python-dotenv will load it automatically when the app starts.

LLM_MODEL=mistral-small-3.2-24b-instruct
LLM_BASE_URL=http://localhost:1234/v1
LLM_API_KEY=local-dev-key

# Optional — default is 20 seconds
LLM_TIMEOUT_S=20

# ── Login credentials ──────────────────────────────────────────────────────────
# Default (if unset): admin / lette
LETTE_USERNAME=admin
LETTE_PASSWORD=lette
