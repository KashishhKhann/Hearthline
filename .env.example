# Copy this file to .env and fill in your values.
# python-dotenv loads it automatically for the Streamlit app; for the API run
#   uvicorn backend.main:app --env-file .env

# ── Dashboard login (required: sign-in is disabled until both are set) ────────
HEARTHLINE_USERNAME=admin
HEARTHLINE_PASSWORD=change-me

# ── LLM (optional; unset = deterministic mode) ─────────────────────────────────
LLM_MODEL=mistral-small-3.2-24b-instruct
LLM_BASE_URL=http://localhost:1234/v1
LLM_API_KEY=local-dev-key
LLM_TIMEOUT_S=20

# ── API ────────────────────────────────────────────────────────────────────────
# Where the resident's browser sends reports (the FastAPI service).
HEARTHLINE_API_PUBLIC_URL=http://127.0.0.1:8000
# Public HTTPS URL of the API as Twilio sees it (e.g. your ngrok URL). Needed for
# signature checks behind a proxy, delivery callbacks and voice escalation calls.
HEARTHLINE_PUBLIC_URL=
# Key for the admin endpoints (X-Admin-Key header). Leave empty to disable them.
HEARTHLINE_ADMIN_API_KEY=
HEARTHLINE_DB=data/hearthline.db

# ── Twilio (leave empty for dry-run: nothing is sent, everything is logged) ────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_WHATSAPP_FROM=
# On-call rota for critical alerts, first number is texted first.
ONCALL_NUMBERS=
ALERT_ACK_TIMEOUT_MIN=10
# Local testing without signatures ONLY (never in production):
HEARTHLINE_INSECURE_WEBHOOKS=0

# ── SendGrid email replies (optional) ──────────────────────────────────────────
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
